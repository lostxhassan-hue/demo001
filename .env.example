# ═══════════════════════════════════════════════════════════════
# .env.example — Copy or rename this file to .env.local
# and paste your real credentials into it.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# DATABASE (SQLite — used by Prisma)
# ───────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ───────────────────────────────────────────────────────────────
# AUTHENTICATION
# ───────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long-change-in-production"
AUTH_TOKEN_EXPIRY="7d"

# ───────────────────────────────────────────────────────────────
# ADMIN CREDENTIALS (initial seed — change after first login!)
# ───────────────────────────────────────────────────────────────
ADMIN_USERNAME="hassan1ch"
ADMIN_PASSWORD="hassan1234ch"

# ───────────────────────────────────────────────────────────────
# SHOPIFY — paste your real values in .env.local
# ───────────────────────────────────────────────────────────────
# Your store domain, e.g. "my-store.myshopify.com" (NO https://)
SHOPIFY_STORE_URL="your-store.myshopify.com"
# Admin API access token (starts with shpss_ or shpat_)
SHOPIFY_ACCESS_TOKEN="shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# REST API version (keep as 2024-01 unless you know otherwise)
SHOPIFY_API_VERSION="2024-01"
# Optional — only needed for webhook signature verification
SHOPIFY_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────────
# META / FACEBOOK & INSTAGRAM ADS — paste your real values
# ───────────────────────────────────────────────────────────────
# System User access token (never expires; requires ads_read + ads_management)
META_ACCESS_TOKEN=""
# Ad Account ID from Ads Manager (format: act_1234567890)
META_AD_ACCOUNT_ID=""
# App ID (Meta for Developers → App Settings → Basic)
META_APP_ID=""
# App Secret (Meta for Developers → App Settings → Basic)
META_APP_SECRET=""

# ───────────────────────────────────────────────────────────────
# META — sync window (optional, defaults to 30 days)
# ───────────────────────────────────────────────────────────────
META_SYNC_DAYS="30"

# ───────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API (optional)
# ───────────────────────────────────────────────────────────────
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ───────────────────────────────────────────────────────────────
# COURIER (architecture ready, no real courier connected yet)
# ───────────────────────────────────────────────────────────────
COURIER_API_URL="https://api.courier.com"
COURIER_API_KEY=""
COURIER_CLIENT_ID=""
COURIER_CLIENT_SECRET=""
COURIER_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────────
# EMAIL / SMTP (optional)
# ───────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ───────────────────────────────────────────────────────────────
# FILE UPLOAD
# ───────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"

# ───────────────────────────────────────────────────────────────
# APP
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Business Management System"
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_TIMEZONE="Asia/Karachi"
