# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long-change-in-production"
AUTH_TOKEN_EXPIRY="7d"

# Admin Credentials (for initial setup - change after first login)
ADMIN_USERNAME="hassan1ch"
ADMIN_PASSWORD="hassan1234ch"

# Shopify Integration
SHOPIFY_STORE_URL="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-01"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# WhatsApp Business API
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token"
WHATSAPP_APP_SECRET="your-app-secret"

# Courier Integration (Generic - configure per courier)
COURIER_API_URL="https://api.courier.com"
COURIER_API_KEY="your-courier-api-key"
COURIER_CLIENT_ID="your-client-id"
COURIER_CLIENT_SECRET="your-client-secret"
COURIER_WEBHOOK_SECRET="your-courier-webhook-secret"

# Meta Ads API
META_ACCESS_TOKEN="your-meta-access-token"
META_AD_ACCOUNT_ID="act_xxxxxxxxxxxx"
META_APP_ID="your-app-id"
META_APP_SECRET="your-app-secret"

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourbusiness.com"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Business Management System"
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_TIMEZONE="Asia/Karachi"