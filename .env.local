# ═══════════════════════════════════════════════════════════════════════
# LOCAL / PRIVATE API CREDENTIALS — .env.local
# ═══════════════════════════════════════════════════════════════════════
# Next.js loads this file automatically and it OVERRIDES values in .env.
# Never commit this file and never paste credentials into source code.
# See API_SETUP.md for exactly where to find each value.

# ───────────────────────────────────────────────────────────────────────
# SHOPIFY — paste your real values below
# ───────────────────────────────────────────────────────────────────────
# Your store's admin domain (NO "https://", e.g. "my-store.myshopify.com")
SHOPIFY_STORE_URL="1480nb-ih.myshopify.com"
# Admin API access token (Shopify Admin → Settings → Apps & sales channels
# → Develop apps → your app → Admin API access token)
SHOPIFY_ACCESS_TOKEN="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"
# Shopify API version used for all REST calls
SHOPIFY_API_VERSION="2024-01"
# Only needed for webhook signature verification (optional)
SHOPIFY_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────────────────
# META / FACEBOOK & INSTAGRAM ADS — paste your real values below
# ───────────────────────────────────────────────────────────────────────
# Long-lived System User access token with ads_read / ads_management
# (Meta for Developers → https://developers.facebook.com → Marketing API)
META_ACCESS_TOKEN=""
# Ad Account ID from Ads Manager (format: act_1234567890)
META_AD_ACCOUNT_ID=""
# App ID (Meta for Developers → App Settings → Basic)
META_APP_ID=""
# App Secret (Meta for Developers → App Settings → Basic → Show)
META_APP_SECRET=""

# ───────────────────────────────────────────────────────────────────────
# Convenience "last sync" control for the ad-spend backfill
# ───────────────────────────────────────────────────────────────────────
# How many days back the Meta ads sync should pull when you click
# "Sync Now" (defaults to 30 if not set).
META_SYNC_DAYS="30"